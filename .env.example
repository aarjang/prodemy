# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DB_ENGINE empty for SQLite. Set to "postgresql" for PostgreSQL.
DB_ENGINE=
DB_NAME=prodemy
DB_USER=prodemy
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Used only when DJANGO_DEBUG is False (password reset emails).
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com

# Seconds between Wallex price reads.
PRICE_POLL_SECONDS=30
